{
  "name": "metis-ui",
  "version": "6.0.0",
  "license": "MIT",
  "scripts": {
    "check-circular": "dpdm --no-warning --no-tree pdm  --no-warning --no-tree  projects/metis/src/main.ts  projects/metis/src/main.ts",
    "check-circular:sandbox": "dpdm --no-warning --no-tree pdm  --no-warning --no-tree  projects/sandbox/src/main.ts  projects/sandbox/src/main.ts",
    "ng": "ng",
    "start-metis": "ng serve metis",
    "start-sandbox": "ng serve sandbox",
    "start": "npm run start-metis",
    "build-metis": "ng build metis",
    "build-sandbox": "ng build sandbox",
    "build-shared": "ng build shared",
    "build": "npm run build-shared && npm run build-metis && npm run build-sandbox",
    "clean": "rm -rf .angular/cache && rm -rf projects/metis/test-data/src-copy rm -rf projects/sandbox/test-data/src-copy && rm -rf ./dist && rm -rf ./projects/**/dist && rm -rf ./projects/**/coverage",
    "prettier": "prettier --write '{tools/**/*.{ts,js,json,mjs},shared-styles/**/*.scss,projects/**/{shared-styles,src,cypress,test-data}/**/*.{ts,js,json,scss,html}}' '*.{scss,js,json}'",
    "prettier:ci": "prettier --list-different '(tools/**/*.{ts,js,json,mjs},shared-styles/**/*.scss,projects/**/{src,cypress,test-data}/**/*.{ts,js,json,scss,html}}' '*.{js,json}'",
    "lint-metis": "NODE_OPTIONS='--max-old-space-size=8192'  eslint projects/metis --fix --cache --config eslint.config.mjs",
    "lint-sandbox": "NODE_OPTIONS='--max-old-space-size=8192'  eslint projects/sandbox --fix --cache --config eslint.config.mjs",
    "lint-shared": "NODE_OPTIONS='--max-old-space-size=8192' eslint projects/shared --fix --cache --config eslint.config.mjs",
    "lint:ci-metis": "eslint projects/metis/src/app",
    "lint:ci-sandbox": "eslint projects/sandbox/src/app",
    "lint:ci": "NODE_OPTIONS='--max-old-space-size=8192' npm run lint:ci-metis && npm run lint:ci-sandbox && npm run lint:ci-shared",
    "lint": "npm run lint-shared && npm run lint-metis && npm run lint-sandbox",
    "fix": "npm run prettier && npm run lint",
    "test:dev-metis": "ng test metis --watch=false --progress=false --code-coverage --karma-config=projects/metis/karma.conf.cjs && mkdir -p projects/metis/coverage && mv coverage/metis/lcov.info projects/metis/coverage/lcov.info",
    "test:dev-sandbox": "CI=1 VITEST_POOL_OPTIONS='threads.singleThread=true' ng test sandbox --code-coverage && mkdir -p projects/sandbox/coverage && mv coverage/lcov.info projects/sandbox/coverage/lcov.info",
    "test:dev-shared": "CI=1 VITEST_POOL_OPTIONS='threads.singleThread=true' ng test shared --code-coverage && mkdir -p projects/shared/coverage && mv coverage/lcov.info projects/shared/coverage/lcov.info",
    "test:dev": "npm run test:dev-shared && npm run test:dev-sandbox && npm run test:dev-metis",
    "test": "npm run prettier:ci && npm run lint:ci && npm run build-shared && npm run template-check && npm run test:e2e",
    "test:ci-any": "ng test ${npm_config_project} --progress=false --watch=false --code-coverage --source-map=false",
    "test:ci-metis": "npm run test:ci-any --project=metis",
    "test:ci-sandbox": "npm run test:ci-any --project=sandbox",
    "test:ci-shared": "npm run test:ci-any --project=shared",
    "test:ci": "npm run test:ci-sandbox && npm run test:ci-shared && npm run test:ci-metis",
    "prep-test-source": "node tools/test-data-prep/copy-source-files-to-ci.mjs ${npm_config_project}",
    "test:accessibility-any": "npm run tsc-test-data --project=${npm_config_project} && ((node --use_strict ./projects/${npm_config_project}/dist/out-tsc/projects/${npm_config_project}/test-data/index.mjs) & (npm run cypress:ci-accessibility-any --project=${npm_config_project}; fuser -k 3000/tcp))",
    "test:e2e-any": "npm run prep-test-source --project=${npm_config_project} && npm run tsc-test-data --project=${npm_config_project} && ((node --use_strict ./projects/${npm_config_project}/dist/out-tsc/projects/${npm_config_project}/test-data/index.mjs) & (npm run cypress:ci-any --project=${npm_config_project}; fuser -k 3000/tcp))",
    "test:e2e-metis": "npm run test:e2e-any --project=metis",
    "test:e2e-sandbox": "npm run test:e2e-any --project=sandbox",
    "test:accessibility-metis": "npm run test:accessibility-any --project=metis",
    "test:accessibility-sandbox": "npm run test:accessibility-any --project=sandbox",
    "test:accessibility": "npm run test:accessibility-metis && npm run test:accessibility-sandbox",
    "test:e2e": "npm run test:e2e-metis && npm run test:e2e-sandbox",
    "template-check-any": "ng build ${npm_config_project} --progress=false --output-path=tmp/template-check --aot",
    "template-check-metis": "npm run template-check-any --project=metis",
    "template-check-sandbox": "npm run template-check-any --project=sandbox",
    "template-check-shared": "echo 'no templates available in shared yet'",
    "template-check": "npm run template-check-metis && npm run template-check-sandbox && npm run template-check-shared",
    "tsc-test-data": "tsc --project projects/${npm_config_project}/src/tsconfig.test-data.json",
    "tsc": "npm run tsc-test-data --project=metis && npm run tsc-test-data --project=sandbox",
    "cypress:ci-any": "run-p --race start:ci-any cypress:run --project=${npm_config_project}",
    "cypress:ci-accessibility-any": "run-p --race start:ci-any cypress:run-accessibility --project=${npm_config_project}",
    "cypress:run": "sleep 10 && cypress run --project projects/${npm_config_project} --browser=chrome --config '{\"component\": {},  \"e2e\": { \"excludeSpecPattern\": \"**/**a11y.cy.ts\"}}'",
    "cypress:run-accessibility": "sleep 10 && cypress run --project projects/${npm_config_project}/src --spec **/*a11y.cy.ts",
    "cypress:open-sandbox": "cypress open --project projects/sandbox",
    "cypress": "cypress open --project projects/metis",
    "start:ci-any": "ng serve --project=${npm_config_project} --port 4280 --live-reload=false --configuration=e2e",
    "start:ci-sandbox": "ng serve --project=sandbox --port 4280 --live-reload=false --configuration=e2e",
    "start:ci-metis": "ng serve --project=metis --port 4280 --live-reload=false --configuration=e2e",
    "start:ci": "npm run start:ci-metis",
    "start:ci-data-any": "npm run prep-test-source && npm run tsc-test-data && node ./projects/${npm_config_project}/dist/out-tsc/projects/${npm_config_project}/test-data/index.mjs",
    "start:ci-data-metis": "npm run start:ci-data-any --project=metis",
    "start:ci-data-sandbox": "npm run start:ci-data-any --project=sandbox",
    "start:ci-data": "npm run start:ci-data-metis",
    "dist-any": "ng build ${npm_config_project} --progress=false --configuration production && cp -R dist/shared/. projects/${npm_config_project}/dist/${npm_config_project}",
    "dist-metis": "npm run dist-any --project=metis",
    "dist-sandbox": "npm run dist-any --project=sandbox",
    "dist-shared": "ng build --project=shared --configuration production && cp -r dist/shared projects/shared/dist",
    "dist": "npm run dist-metis",
    "i18n": "ng xi18n --output-path locale --out-file messages.en-GB.xlf",
    "lite": "test -d ./projects/metis/dist/metis/browser && lite-server --baseDir=./projects/metis/dist/metis/browser || echo '(run dist first)'",
    "lite-sandbox": "test -d ./projects/sandbox/dist/sandbox/browser && lite-server --baseDir=./projects/sandbox/dist/sandbox/browser || echo '(run dist-sandbox first)'"
  },
  "private": true,
  "engines": {
    "node": ">= v24.14.0",
    "npm": ">=10.1.0"
  },
  "dependencies": {
    "@angular/cdk": "^20.2.12",
    "@angular/common": "^20.3.19",
    "@angular/core": "^20.3.19",
    "@angular/forms": "^20.3.18",
    "@angular/localize": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@ctrl/ngx-codemirror": "^7.0.0",
    "@europeana/metis-ui-consent-management": "^20.3.19",
    "@europeana/metis-ui-maintenance-utils": "^20.3.19",
    "@europeana/metis-ui-test-utils": "^20.3.19",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "chart.js": "^4.3.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "codemirror": "^5.65.15",
    "core-js": "^2.6.12",
    "cypress": "^15.13.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.20.1",
    "jasmine": "^5.1.0",
    "jasmine-core": "^6.2.0",
    "jspdf": "^4.2.1",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "keycloak-angular": "^20.1.0",
    "keycloak-js": "^26.1.1",
    "loader-utils": "^3.2.1",
    "lodash-es": "^4.17.20",
    "ng2-charts": "^9.0.0",
    "ngx-cookie-service": "^20.1.1",
    "ngx-matomo-client": "^8.0.0",
    "rxjs": "^7.5.5",
    "sass-loader": "^12.3.0",
    "tslib": "^2.0.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.22",
    "@angular/build": "^20.3.22",
    "@angular/cli": "^20.3.22",
    "@angular/compiler": "^20.3.18",
    "@angular/compiler-cli": "^20.3.18",
    "@angular/language-service": "^20.3.18",
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.4",
    "@cypress/webpack-preprocessor": "^5.12.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@schematics/angular": "^20.3.24",
    "@stylistic/eslint-plugin": "^4.0.0",
    "@types/codemirror": "0.0.71",
    "@types/jasmine": "^3.10.2",
    "@types/jasminewd2": "^2.0.8",
    "@vitest/coverage-v8": "^3.2.4",
    "angular2-template-loader": "^0.6.2",
    "axe-core": "^4.10.3",
    "babel-loader": "^8.2.3",
    "dpdm": "^3.10.0",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "jasmine-spec-reporter": "~5.0.0",
    "jsdom": "^29.1.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "~3.1.0",
    "lite-server": "^2.6.1",
    "ng-mocks": "^14.15.2",
    "ng-packagr": "^20.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.19.1",
    "tar": "^7.4.3",
    "ts-loader": "^9.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^0.0.1-alpha.0",
    "vitest": "^3.2.4",
    "webpack": "^5.106.2"
  },
  "prettier": {
    "arrowParens": "always",
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
